# PLANTILLA para la aplicación WireGuard en Windows.
# Conservar la clave privada que genera WireGuard en el cliente.
# Este endpoint solo funciona en la red interna del laboratorio VirtualBox.

[Interface]
PrivateKey = CONSERVAR_LA_CLAVE_PRIVADA_GENERADA_EN_WINDOWS
Address = 10.10.10.2/24

[Peer]
PublicKey = REEMPLAZAR_CON_CLAVE_PUBLICA_DEL_SERVIDOR
AllowedIPs = 10.10.10.1/32
Endpoint = 192.168.50.10:51820
PersistentKeepalive = 25
