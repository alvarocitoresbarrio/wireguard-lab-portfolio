# Plantilla para el cliente oficial WireGuard en Windows.
# Nunca publiques la clave privada real del cliente.
[Interface]
PrivateKey = REEMPLAZAR_POR_CLAVE_PRIVADA_DEL_CLIENTE
Address = 10.10.10.2/24

[Peer]
PublicKey = REEMPLAZAR_POR_CLAVE_PUBLICA_DEL_SERVIDOR
AllowedIPs = 10.10.10.1/32
Endpoint = 192.168.50.10:51820
PersistentKeepalive = 25
